{
  "name": "BacklinkQualityAnalysis",
  "type": "object",
  "properties": {
    "website_url": {
      "type": "string"
    },
    "backlink_url": {
      "type": "string"
    },
    "target_url": {
      "type": "string"
    },
    "anchor_text": {
      "type": "string"
    },
    "overall_score": {
      "type": "number",
      "default": 0
    },
    "classification": {
      "type": "string"
    },
    "risk_level": {
      "type": "string"
    },
    "recommendation": {
      "type": "string"
    },
    "data_confidence": {
      "type": "string"
    },
    "report_json": {
      "type": "string",
      "maxLength": 12000
    }
  },
  "required": [
    "backlink_url"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}