{
  "name": "BacklinkGap",
  "type": "object",
  "properties": {
    "analysis_id": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "source_title": {
      "type": "string"
    },
    "domain_authority": {
      "type": "number"
    },
    "traffic": {
      "type": "number"
    },
    "backlink_type": {
      "type": "string"
    },
    "competitor_count": {
      "type": "number",
      "default": 1
    },
    "competitor_names": {
      "type": "string"
    },
    "relevance_score": {
      "type": "number"
    },
    "opportunity_score": {
      "type": "number"
    },
    "priority": {
      "type": "string",
      "default": "Medium"
    },
    "guest_post_url": {
      "type": "string"
    },
    "contact_url": {
      "type": "string"
    },
    "niche": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "is_broken": {
      "type": "boolean",
      "default": false
    },
    "is_demo": {
      "type": "boolean",
      "default": true
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "analysis_id",
    "domain"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}