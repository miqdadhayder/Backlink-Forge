{
  "name": "Search",
  "type": "object",
  "properties": {
    "website_url": {
      "type": "string"
    },
    "keyword": {
      "type": "string"
    },
    "country": {
      "type": "string",
      "default": "Global"
    },
    "backlink_type": {
      "type": "string",
      "default": "All Opportunities"
    },
    "minimum_da": {
      "type": "number",
      "default": 20
    },
    "results_count": {
      "type": "number",
      "default": 25
    },
    "competitor_url": {
      "type": "string"
    },
    "search_type": {
      "type": "string",
      "enum": [
        "backlinks",
        "guest_posts",
        "competitor"
      ],
      "default": "backlinks"
    },
    "is_demo": {
      "type": "boolean",
      "default": true
    },
    "opportunities_found": {
      "type": "number",
      "default": 0
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "website_url",
    "keyword"
  ]
}