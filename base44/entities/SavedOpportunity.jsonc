{
  "name": "SavedOpportunity",
  "type": "object",
  "properties": {
    "opportunity_id": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "domain_authority": {
      "type": "number"
    },
    "traffic": {
      "type": "number"
    },
    "niche": {
      "type": "string"
    },
    "backlink_type": {
      "type": "string"
    },
    "guest_post_available": {
      "type": "boolean",
      "default": false
    },
    "relevance_score": {
      "type": "number"
    },
    "difficulty": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "opportunity_id",
    "website",
    "url"
  ],
  "rls": {
    "read": {
      "$or": [
        { "created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": {
      "$or": [
        { "created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "delete": {
      "$or": [
        { "created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    }
  }
}