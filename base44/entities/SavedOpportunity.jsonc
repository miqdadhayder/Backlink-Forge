      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "domain_authority": {
      "type": "number"
    },
    "traffic": {
      "type": "number"
    },
    "niche": {
      "type": "string"
    },
    "backlink_type": {
      "type": "string"
    },
    "guest_post_available": {
      "type": "boolean",
      "default": false
    },
    "relevance_score": {
      "type": "number"
    },
    "difficulty": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
