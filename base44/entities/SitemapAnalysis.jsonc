{
  "name": "SitemapAnalysis",
  "type": "object",
  "properties": {
    "website_url": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "generate",
        "validate"
      ],
      "default": "generate"
    },
    "sitemap_type": {
      "type": "string"
    },
    "urls_found": {
      "type": "number",
      "default": 0
    },
    "urls_included": {
      "type": "number",
      "default": 0
    },
    "errors": {
      "type": "number",
      "default": 0
    },
    "warnings": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "default": "completed"
    },
    "health": {
      "type": "number",
      "default": 0
    },
    "robots_found": {
      "type": "boolean",
      "default": false
    },
    "existing_sitemaps": {
      "type": "string"
    },
    "xml_preview": {
      "type": "string"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "website_url",
    "type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}