{
  "name": "BacklinkGapAnalysis",
  "type": "object",
  "properties": {
    "website_url": {
      "type": "string"
    },
    "keyword": {
      "type": "string"
    },
    "country": {
      "type": "string",
      "default": "Global"
    },
    "minimum_da": {
      "type": "number",
      "default": 20
    },
    "backlink_types": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "default": "completed"
    },
    "result_count": {
      "type": "number",
      "default": 0
    },
    "is_demo": {
      "type": "boolean",
      "default": true
    },
    "competitors_summary": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "website_url"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}