{
  "name": "Opportunity",
  "type": "object",
  "properties": {
    "search_id": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "domain_authority": {
      "type": "number"
    },
    "traffic": {
      "type": "number"
    },
    "niche": {
      "type": "string"
    },
    "backlink_type": {
      "type": "string"
    },
    "guest_post_available": {
      "type": "boolean",
      "default": false
    },
    "guest_post_url": {
      "type": "string"
    },
    "contact_url": {
      "type": "string"
    },
    "submission_requirements": {
      "type": "string"
    },
    "relevance_score": {
      "type": "number"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "Easy",
        "Medium",
        "Hard"
      ],
      "default": "Medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "Available",
        "Contacted",
        "Pending",
        "Expired"
      ],
      "default": "Available"
    },
    "country": {
      "type": "string"
    },
    "is_demo": {
      "type": "boolean",
      "default": true
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "website",
    "url",
    "backlink_type"
  ],
  "rls": {
    "read": {
      "$or": [
        { "created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": {
      "$or": [
        { "created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "delete": {
      "$or": [
        { "created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    }
  }
}